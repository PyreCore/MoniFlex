<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de lancement Android (avant Android 12) : logo MoniFlex centré sur
     le fond de l'app. Android 12+ affiche l'icône de l'app automatiquement. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#E9EFEC" />
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>